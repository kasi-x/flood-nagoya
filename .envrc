# Auto-activate the project environment on cd (direnv).
# pixi projects: the dev environment via shell-hook. uv projects: the venv from `uv sync`.
if command -v pixi >/dev/null 2>&1 && [ -f pixi.lock ]; then
    watch_file pixi.lock
    dotenv_if_exists .env
    eval "$(pixi shell-hook -e dev)"
elif [ -d .venv ]; then
    source .venv/bin/activate
fi
